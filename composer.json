{
    "name": "ahbaqdadi/php-genetic",
    "description": "A small, pluggable genetic algorithm toolkit for PHP.",
    "type": "library",
    "autoload": {
        "psr-4": {
            "Ahbaqdadi\\PhpGenetic\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ahbaqdadi\\PhpGenetic\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "ahbaqdadi"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "symfony/var-dumper": "^6.1"
    },
    "require": {
        "php": "^8.1",
        "symfony/stopwatch": "^6.1"
    },
    "scripts": {
        "test": "phpunit"
    }
}
